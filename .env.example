# Shared database -----------------------------------------------------------
# One SQLite file for the engine and the Stock CRM (default <workspace>/data/market.db).
# knowledge_* tables: engine writes; personal_* tables: CRM writes; see `python cli.py knowledge registry`.
# SHARED_DATA_DIR=C:/Users/Drew/Desktop/workspace/data
# DATABASE_URL=sqlite:///C:/Users/Drew/Desktop/workspace/data/market.db

# Copy to .env and edit. All values optional; defaults shown.

# SQLite by default (data/twstock.db). Any SQLAlchemy URL works but ON CONFLICT upserts target SQLite.
# DATABASE_URL=sqlite:///data/twstock.db

# Scheduler
SCHEDULER_ENABLED=true
REALTIME_INTERVAL_SECONDS=10
BACKFILL_MONTHS=6
REQUEST_DELAY_SECONDS=1.5

# Accounts ---------------------------------------------------------------------
# First boot creates this admin when no user exists (otherwise a random-password 'admin' is logged).
# Afterwards manage accounts in the UI (帳號管理) or `python cli.py users ...`.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_DAYS=30
# COOKIE_SECURE=true forces Secure cookies; by default Secure is applied automatically over HTTPS.

# Stock CRM link ---------------------------------------------------------------
CRM_BASE_URL=http://127.0.0.1:8765
# Shared secret so the CRM trusts the identity headers the engine forwards (same value on both sides).
# Local services may also send it as X-Service-Token (+ X-User-Id) to read /api/market/* without a login.
CRM_FACADE_TOKEN=
CRM_SYNC_ALERTS=true
CRM_PROPOSALS=true

# Notifications ---------------------------------------------------------------
NOTIFY_CONSOLE=true

# LINE Messaging API (LINE Notify was discontinued in 2025).
# 1. Create a Messaging API channel at https://developers.line.biz/console/
# 2. Issue a long-lived channel access token
# 3. Add the bot as a friend; your user ID is shown under "Basic settings" of the channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# Email via SMTP (Gmail: smtp.gmail.com:587 with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_TO=

# Knowledge-layer LLM extractor (proposals only; off by default) ------------------
# ANTHROPIC_API_KEY=
# EXTRACTOR_ENABLED=true
# EXTRACTOR_MODEL=claude-opus-5-5
# EXTRACTOR_BATCH=8
